	if($p>1){
		$to=$p*$rec;
		$from=$to-$rec;
		$i=$to+1-$rec;
	}else{
		$to=$rec;
		$from=0;
		$i=1;
		$p=1;
	}
	
	$ex=$link->query("select * from msgout where (
	    idn like'%".$value."%' or
		msg_from like'%".$value."%' or		
		msg_office like'%".$value."%' or		
		msg_to like'%".$value."%' or		
		msg_attn like'%".$value."%' or		
		msg_month like'%".$value."%' or			
		msg_day like'%".$value."%' or
		msg_year like'%".$value."%' or
		msg_content like'%".$value."%') $msg order by idn DESC LIMIT $from,$to ");		

	$ex1=$link->query("select * from msgout where (
	    idn like'%".$value."%' or
